# Supabase (publishable values are safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UPSTAGE_API_KEY=
UPSTAGE_EMBEDDING_MODEL=solar-embedding-2-query
UPSTAGE_PASSAGE_MODEL=solar-embedding-2-passage

# Required only by the local dataset ingestion script. Use a Supabase secret key.
SUPABASE_SECRET_KEY=
